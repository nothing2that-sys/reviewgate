<Window x:Class="ReviewGate.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ReviewGate" Height="780" Width="1120" MinHeight="560" MinWidth="860"
        FontFamily="Malgun Gothic" FontSize="13" Loaded="OnLoaded">
    <DockPanel>
        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem><TextBlock x:Name="StatusText" Text="준비" /></StatusBarItem>
        </StatusBar>
        <!-- Price snapshot status: highlighted from 7 days before expiry; refresh asks Claude Code and Codex, then the user approves -->
        <Border x:Name="PriceBanner" DockPanel.Dock="Top" Margin="8,8,8,0" Padding="10,6" BorderThickness="1" BorderBrush="#D0D0D0" CornerRadius="3">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="가격표 갱신" Click="OnRefreshPrices" />
                <TextBlock x:Name="PriceBannerText" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,10,0" />
            </DockPanel>
        </Border>
        <TabControl Margin="8">
            <!-- API keys: one panel per provider in the catalog, built in code -->
            <TabItem Header="API 키">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="12">
                        <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,10"
                                   Text="제공자마다 키를 여러 개 이름을 붙여 저장하고, 그중 하나를 골라 사용합니다. 키 값은 Windows 자격 증명 관리자에 저장되며 이 화면에는 이름만 표시됩니다. 같은 Windows 계정에서 실행되는 프로그램은 저장된 키를 읽을 수 있으므로, 제공자 콘솔에서 ReviewGate 전용 키와 월 사용 한도를 함께 설정하세요." />
                        <StackPanel x:Name="KeyPanels" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Models -->
            <TabItem Header="모델">
                <DockPanel Margin="12">
                    <GroupBox DockPanel.Dock="Top" Header="제공자별 대표 모델과 서브 모델">
                        <StackPanel>
                            <CheckBox x:Name="GoogleFreeTier" Content="Google은 무료 티어로 사용 (가격 0으로 계산, 전송 전에 데이터 사용 경고 표시)" Margin="0,0,0,8" />
                            <Grid x:Name="ModelGrid">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                            </Grid>
                            <TextBlock Style="{StaticResource Hint}" Text="서브 모델은 대표 모델이 응답하지 않을 때(시간 초과·연결 끊김·서버 혼잡 503·호출 한도 429)만 씁니다. 전송 승인 창에 함께 표시되고, 결과에도 어느 모델이 답했는지 남습니다. 키 오류나 모델이 답했지만 잘린 경우에는 서브로 넘어가지 않습니다." />
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <Button Content="설정 저장" Click="OnSaveSettings" />
                            </StackPanel>
                        </StackPanel>
                    </GroupBox>
                    <GroupBox DockPanel.Dock="Bottom" Header="모델 추가 (제공자가 새 모델을 낸 경우)">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <ComboBox x:Name="CustomProvider" Width="120" DisplayMemberPath="DisplayName" />
                                <TextBlock Text="  모델 ID " VerticalAlignment="Center" />
                                <TextBox x:Name="CustomModelId" Width="250" />
                                <CheckBox x:Name="CustomFree" Content=" 무료" VerticalAlignment="Center" Margin="12,0" />
                                <TextBlock Text="입력 $" VerticalAlignment="Center" />
                                <TextBox x:Name="CustomInput" Width="60" />
                                <TextBlock Text="  출력 $" VerticalAlignment="Center" />
                                <TextBox x:Name="CustomOutput" Width="60" />
                                <TextBlock Text=" /100만 token  " VerticalAlignment="Center" />
                                <Button Content="추가" Click="OnAddCustomModel" />
                                <Button Content="선택한 사용자 모델 삭제" Click="OnRemoveCustomModel" />
                            </StackPanel>
                            <TextBlock Style="{StaticResource Hint}" Text="가격은 입력한 값으로 예산을 계산합니다. 제공자 가격표를 확인하고 입력하세요. 모델 ID는 제공자 문서의 이름을 그대로 씁니다(예: Together는 'zai-org/GLM-5.3-Flash')." />
                        </StackPanel>
                    </GroupBox>
                    <DataGrid x:Name="ModelsGrid" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" Margin="0,0,0,12">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="제공자" Binding="{Binding Provider}" Width="90" />
                            <DataGridTextColumn Header="모델" Binding="{Binding ModelId}" Width="*" />
                            <DataGridTextColumn Header="가격" Binding="{Binding PriceText}" Width="260" />
                            <DataGridTextColumn Header="최대 출력" Binding="{Binding MaxOutputTokens}" Width="80" />
                            <DataGridTextColumn Header="추론 설정" Binding="{Binding ReasoningEffort}" Width="80" />
                            <DataGridCheckBoxColumn Header="사용자 추가" Binding="{Binding Custom}" Width="80" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <!-- Quick test -->
            <TabItem Header="간이 테스트">
                <Grid Margin="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="440" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,0,12,0">
                        <StackPanel>
                            <TextBlock Text="검수자 (제공자의 사용 중인 키와 대표 모델)" FontWeight="SemiBold" />
                            <ComboBox x:Name="ReviewerA" DisplayMemberPath="Label" Margin="0,4" />
                            <TextBlock Text="두 번째 검수자 (선택하면 서로의 결과를 보지 않는 독립 검수)" Style="{StaticResource Hint}" />
                            <ComboBox x:Name="ReviewerB" DisplayMemberPath="Label" Margin="0,4" />
                            <CheckBox x:Name="UseFallback" Content="대표 모델이 응답하지 않으면 서브 모델 사용" IsChecked="True" Margin="0,4" />
                            <TextBlock Text="검수 유형" FontWeight="SemiBold" Margin="0,8,0,0" />
                            <ComboBox x:Name="ProfileKind" SelectedIndex="0" Margin="0,4">
                                <ComboBoxItem Content="코드" Tag="code" />
                                <ComboBoxItem Content="기획서·문서" Tag="document" />
                                <ComboBoxItem Content="소설" Tag="novel" />
                            </ComboBox>
                            <TextBlock Text="검수 지시" FontWeight="SemiBold" Margin="0,8,0,0" />
                            <TextBox x:Name="Instruction" Height="60" TextWrapping="Wrap" AcceptsReturn="True" Margin="0,4"
                                     Text="정확성 결함을 찾아 원문 인용과 함께 보고하세요. 근거가 없으면 지적하지 마세요." />
                            <TextBlock Text="검수 자료" FontWeight="SemiBold" Margin="0,8,0,0" />
                            <RadioButton x:Name="UseText" Content="텍스트 붙여넣기" IsChecked="True" Margin="0,4" />
                            <TextBox x:Name="SourceText" Height="150" AcceptsReturn="True" AcceptsTab="True" FontFamily="Consolas"
                                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" />
                            <RadioButton x:Name="UsePath" Content="파일 또는 폴더" Margin="0,8,0,4" />
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="폴더" Click="OnPickFolder" Margin="4,0,0,0" MinWidth="50" />
                                <Button DockPanel.Dock="Right" Content="파일" Click="OnPickFile" Margin="4,0,0,0" MinWidth="50" />
                                <TextBox x:Name="SourcePath" />
                            </DockPanel>
                            <CheckBox x:Name="ConfirmNonSensitive" Margin="0,10,0,0">
                                <TextBlock TextWrapping="Wrap" Text="외부 AI 제공자에게 보내도 되는 비민감 자료입니다 (회사 기밀·개인정보 아님)." />
                            </CheckBox>
                            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                <Button x:Name="PreviewButton" Content="미리보기" Click="OnPreview" />
                                <Button x:Name="RunButton" Content="승인하고 실행" Click="OnRun" IsEnabled="False" />
                                <Button x:Name="CancelButton" Content="취소" Click="OnCancel" IsEnabled="False" />
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                    <DockPanel Grid.Column="1">
                        <TextBox DockPanel.Dock="Top" x:Name="PreviewText" Height="160" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Background="#F7F7F7" />
                        <TextBlock DockPanel.Dock="Top" x:Name="ResultSummary" Margin="0,10,0,4" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,6,0,0">
                            <Button x:Name="ReportButton" Content="보고서 보기" Click="OnShowReport" IsEnabled="False" />
                        </StackPanel>
                        <ListBox DockPanel.Dock="Bottom" x:Name="NotesList" Height="60" Margin="0,6,0,0" />
                        <DataGrid x:Name="FindingsGrid" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" RowDetailsVisibilityMode="VisibleWhenSelected">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="모델" Binding="{Binding Reviewer}" Width="140" />
                                <DataGridTextColumn Header="종류" Binding="{Binding Kind}" Width="80" />
                                <DataGridTextColumn Header="심각도" Binding="{Binding Severity}" Width="70" />
                                <DataGridTextColumn Header="위치" Binding="{Binding Location}" Width="120" />
                                <DataGridTextColumn Header="지적" Binding="{Binding Claim}" Width="*" />
                                <DataGridTextColumn Header="근거 확인" Binding="{Binding Evidence}" Width="170" />
                            </DataGrid.Columns>
                            <DataGrid.RowDetailsTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="8">
                                        <TextBlock Text="{Binding Detail}" TextWrapping="Wrap" />
                                        <TextBox Text="{Binding Quote, Mode=OneWay}" IsReadOnly="True" FontFamily="Consolas" Margin="0,6,0,0" TextWrapping="Wrap" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGrid.RowDetailsTemplate>
                        </DataGrid>
                    </DockPanel>
                </Grid>
            </TabItem>

            <!-- Implementation -->
            <TabItem Header="구현">
                <Grid Margin="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="440" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,0,12,0">
                        <StackPanel>
                            <TextBlock Text="저장소 (git 루트 폴더)" FontWeight="SemiBold" />
                            <DockPanel Margin="0,4">
                                <Button DockPanel.Dock="Right" Content="폴더" Click="OnPickRepo" Margin="4,0,0,0" MinWidth="50" />
                                <TextBox x:Name="ImplRepo" />
                            </DockPanel>
                            <TextBlock Text="지시문 파일 (md, txt)" FontWeight="SemiBold" Margin="0,8,0,0" />
                            <DockPanel Margin="0,4">
                                <Button DockPanel.Dock="Right" Content="파일" Click="OnPickInstructionFile" Margin="4,0,0,0" MinWidth="50" />
                                <TextBox x:Name="ImplInstructionFile" />
                            </DockPanel>
                            <TextBlock Text="추가 지시 (선택 — 파일이 없으면 여기에만 써도 됨)" Style="{StaticResource Hint}" />
                            <TextBox x:Name="ImplInstruction" Height="70" TextWrapping="Wrap" AcceptsReturn="True" Margin="0,4" VerticalScrollBarVisibility="Auto" />
                            <TextBlock Text="작업자 (구현할 CLI — 파일 편집만, 명령 실행 불가)" FontWeight="SemiBold" Margin="0,8,0,0" />
                            <ComboBox x:Name="ImplWorker" DisplayMemberPath="Label" Margin="0,4" />
                            <TextBlock Text="교차 검수자 (작업자와 다른 모델)" FontWeight="SemiBold" Margin="0,8,0,0" />
                            <ComboBox x:Name="ImplReviewerA" DisplayMemberPath="Label" Margin="0,4" />
                            <ComboBox x:Name="ImplReviewerB" DisplayMemberPath="Label" Margin="0,4" />
                            <CheckBox x:Name="ImplUseFallback" Content="검수자의 대표 모델이 응답하지 않으면 서브 모델 사용" IsChecked="True" Margin="0,4" />
                            <TextBlock Text="확인 명령 (한 줄에 하나, 작업 뒤 ReviewGate가 실행 — 바뀐 코드를 실행함)" FontWeight="SemiBold" Margin="0,8,0,0" TextWrapping="Wrap" />
                            <TextBox x:Name="ImplChecks" Height="50" AcceptsReturn="True" FontFamily="Consolas" Margin="0,4" VerticalScrollBarVisibility="Auto" />
                            <StackPanel Orientation="Horizontal" Margin="0,4">
                                <TextBlock Text="시간 상한(분) " VerticalAlignment="Center" />
                                <TextBox x:Name="ImplMinutes" Width="50" Text="30" />
                                <TextBlock Text="   검수 비용 상한(USD) " VerticalAlignment="Center" />
                                <TextBox x:Name="ImplReviewUsd" Width="60" Text="1" />
                            </StackPanel>
                            <TextBlock Text="이어서 고칠 브랜치 (비우면 현재 HEAD에서 새 브랜치)" FontWeight="SemiBold" Margin="0,8,0,0" />
                            <TextBox x:Name="ImplContinueBranch" Margin="0,4" FontFamily="Consolas" />
                            <CheckBox x:Name="ImplConfirmNonSensitive" Margin="0,8,0,0">
                                <TextBlock TextWrapping="Wrap" Text="이 저장소 내용을 작업자·검수자(CLI 계정, API 제공자)에게 보내도 됩니다." />
                            </CheckBox>
                            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                <Button x:Name="ImplRunButton" Content="확인하고 구현 시작" Click="OnImplement" />
                                <Button x:Name="ImplCancelButton" Content="취소" Click="OnCancelImplement" IsEnabled="False" />
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                    <DockPanel Grid.Column="1">
                        <TextBox DockPanel.Dock="Top" x:Name="ImplSummary" Height="150" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Background="#F7F7F7" />
                        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,6,0,0">
                            <Button x:Name="ImplMergeButton" Content="현재 브랜치에 병합" Click="OnMergeImplementation" IsEnabled="False" />
                            <Button x:Name="ImplContinueButton" Content="이 브랜치에 이어서 고치기" Click="OnContinueImplementation" IsEnabled="False" />
                            <Button x:Name="ImplDiscardButton" Content="버리기" Click="OnDiscardImplementation" IsEnabled="False" />
                            <Button x:Name="ImplReportButton" Content="검수 보고서" Click="OnShowImplReport" IsEnabled="False" />
                        </StackPanel>
                        <DataGrid DockPanel.Dock="Bottom" x:Name="ImplFindings" Height="150" Margin="0,6,0,0" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" RowDetailsVisibilityMode="VisibleWhenSelected">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="검수자" Binding="{Binding Reviewer}" Width="120" />
                                <DataGridTextColumn Header="심각도" Binding="{Binding Severity}" Width="70" />
                                <DataGridTextColumn Header="위치" Binding="{Binding Location}" Width="120" />
                                <DataGridTextColumn Header="지적" Binding="{Binding Claim}" Width="*" />
                                <DataGridTextColumn Header="근거 확인" Binding="{Binding Evidence}" Width="150" />
                            </DataGrid.Columns>
                            <DataGrid.RowDetailsTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="8">
                                        <TextBlock Text="{Binding Detail}" TextWrapping="Wrap" />
                                        <TextBox Text="{Binding Quote, Mode=OneWay}" IsReadOnly="True" FontFamily="Consolas" Margin="0,6,0,0" TextWrapping="Wrap" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGrid.RowDetailsTemplate>
                        </DataGrid>
                        <TextBox x:Name="ImplDiff" IsReadOnly="True" FontFamily="Consolas" Margin="0,6,0,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" />
                    </DockPanel>
                </Grid>
            </TabItem>

            <!-- History -->
            <TabItem Header="실행 기록">
                <DockPanel Margin="12">
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                        <Button Content="새로고침" Click="OnRefreshRuns" />
                        <Button Content="결과 보기" Click="OnShowRun" />
                        <Button Content="미확정 → 청구 없음으로 정리" Click="OnResolveNoCharge" />
                        <Button Content="미확정 → 예약액을 비용으로 처리" Click="OnResolveConservative" />
                    </StackPanel>
                    <TextBlock DockPanel.Dock="Top" Style="{StaticResource Hint}" Margin="0,0,0,8"
                               Text="'미확정'은 요청을 보냈지만 응답·사용량을 받지 못한 경우입니다(시간 초과, 연결 끊김, 서버 혼잡). 무료 티어 모델은 자동으로 0원 처리됩니다. 청구가 없다고 확인되면 '청구 없음'으로, 확인할 수 없으면 '예약액'으로 정리하세요." />
                    <DataGrid x:Name="RunsGrid" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" Height="220" DockPanel.Dock="Top">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="시각" Binding="{Binding Created, StringFormat=yyyy-MM-dd HH:mm}" Width="130" />
                            <DataGridTextColumn Header="프로젝트" Binding="{Binding Project}" Width="120" />
                            <DataGridTextColumn Header="상태" Binding="{Binding Status}" Width="150" />
                            <DataGridTextColumn Header="오류" Binding="{Binding ErrorCode}" Width="*" />
                            <DataGridTextColumn Header="정산 USD" Binding="{Binding UsageUsd}" Width="100" />
                            <DataGridTextColumn Header="미확정 USD" Binding="{Binding UnknownHoldUsd}" Width="100" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock DockPanel.Dock="Top" x:Name="HistorySummary" Margin="0,10,0,4" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <DataGrid x:Name="HistoryFindings" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="모델" Binding="{Binding Reviewer}" Width="140" />
                            <DataGridTextColumn Header="종류" Binding="{Binding Kind}" Width="80" />
                            <DataGridTextColumn Header="위치" Binding="{Binding Location}" Width="140" />
                            <DataGridTextColumn Header="지적" Binding="{Binding Claim}" Width="*" />
                            <DataGridTextColumn Header="근거 확인" Binding="{Binding Evidence}" Width="170" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
